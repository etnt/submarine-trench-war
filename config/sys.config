%% Runtime configuration for the `stw` release.
%%
%% Everything under the `stw` app is hot-tunable for playtesting: change a
%% value here (or via `application:set_env(stw, Key, Val)` in a running
%% shell) and it takes effect for subsequently created games — no
%% recompile needed. Gameplay defaults live in the source as fallbacks, so
%% only override the keys you actually want to change.
[
    {stw, [
        %% --- Networking ---------------------------------------------
        {http_port, 8080}

        %% Optional HTTPS/`wss://` listener. Uncomment and point at real
        %% PEM files to terminate TLS in-process. If omitted, run plain
        %% HTTP behind a TLS-terminating reverse proxy instead. The client
        %% auto-selects ws:// vs wss:// from the page's protocol.
        %% , {tls, [
        %%     {https_port, 8443},
        %%     {certfile, "/etc/stw/tls/fullchain.pem"},
        %%     {keyfile,  "/etc/stw/tls/privkey.pem"}
        %%     %% , {cacertfile, "/etc/stw/tls/chain.pem"}
        %%   ]}

        %% --- Gameplay tunables (defaults shown) ---------------------
        %% Cards dealt at full hull, and the floor as hull degrades.
        %% , {base_hand, 9}
        %% , {min_hand, 5}
        %% Data nodes a sub must carry before it can extract and win.
        %% , {win_data, 3}
        %% Per-round programming window before auto-lock (milliseconds).
        %% , {ping_timer_ms, 30000}
        %% Every Nth round a trench section caves in.
        %% , {collapse_interval, 3}
    ]},
    {kernel, [
        {logger_level, info}
    ]}
].
